# ============================================================
# REDCap Error Reports — environment template
# ============================================================
# Copy this file to `.env` and fill in the real values:
#
#     cp .env.example .env
#     $EDITOR .env
#
# Never commit `.env` — it contains secrets.
# ============================================================

# ------------------------------------------------------------
# Secrets
# ------------------------------------------------------------

# GitHub personal access token — needed at build time only if
# RedcapData is installed from a private GitHub repo. Leave
# blank to use the public fork.
# Create one at https://github.com/settings/tokens
# Scope required: repo (or public_repo for public-only access).
GITHUB_PAT=replace_me

# Base URL of your REDCap instance. Include the trailing /api/
# if your REDCap requires it.
REDCAP_API_URL=https://redcap.example.org/api/

# API token for the REDCap project you want to validate.
# Generate it in REDCap: Project Setup → API → Generate Token.
# The token must have export rights.
REDCAP_API_TOKEN=replace_me

# ------------------------------------------------------------
# Report scope
# ------------------------------------------------------------

# Number of days back from today to include in the validation.
#   14    → two-week window (routine weekly/fortnightly runs)
#   1100  → full historical sweep (~3 years)
REPORT_INTERVAL=14

# Comma-separated hospital IDs to validate. Leave blank to
# validate every hospital in the project.
#
#   Single:  HOSP_TO_VALIDATE=52
#   Several: HOSP_TO_VALIDATE=52,53,58
#   All:     HOSP_TO_VALIDATE=
#
HOSP_TO_VALIDATE=

# ------------------------------------------------------------
# REDCap field names
# ------------------------------------------------------------
# These are the *internal* REDCap field names, not the labels
# shown on the data-entry form. Rename them if your project uses
# different names. You can find them in REDCap's codebook
# (Project → Codebook) or the Data Dictionary CSV.
# ------------------------------------------------------------

# Primary record identifier field.
ID_VAR=id

# Date-of-entry field used for the date-window filter.
DATE_VAR=date_today

# Hospital identifier field.
HOSP_VAR=hosp_id

# Surrogate patient identifier (e.g. a hashed identifier).
SURROGATE_ID_VAR=ipno

# ------------------------------------------------------------
# Data fetch behaviour
# ------------------------------------------------------------

# true  → query REDCap via a local MySQL database (only works
#         when the container runs on the REDCap DB host).
# false → use the HTTP API at REDCAP_API_URL. This is what you
#         want in almost every case.
LOCAL=false

# Fetch records in chunks. Recommended for large pulls.
CHUNKED=true

# Records per chunk when CHUNKED=true. 100–500 is a good range
# for most projects.
CHUNK_SIZE=200

# ------------------------------------------------------------
# Container / runtime
# ------------------------------------------------------------

# Number of parallel R workers. Keep at 2 for a 4 GB container.
# Increase if you give the container more memory in
# docker-compose.yml (deploy.resources.limits.memory).
R_WORKERS=2

# Host user and group IDs — the container runs as this user so
# files written to ./tmp are owned by you rather than root.
# Find yours with:
#     id -u    # UID
#     id -g    # GID
UID=1000
GID=1000
